########################################################################
#  TheRevProGamers — environment template
#
#  Copy to .env for local development:   cp .env.example .env
#  .env is gitignored. Never commit real tokens.
#
#  In production these go in:
#    · GitHub  → Settings ▸ Secrets and variables ▸ Actions
#                (secrets = tokens, variables = non-sensitive config)
#    · Railway → Project ▸ Variables
#
#  EVERY value here is optional. Nothing set = the site still builds, using
#  the sample data in content/data/fallback/.
########################################################################

# ── Site identity (non-sensitive — use GitHub *Variables*) ────────────
SITE_URL=https://therevprogamers.com
SITE_NAME=TheRevProGamers
SITE_TAGLINE=Games, gear, and things I build.
AUTHOR_NAME=Varun SV
CONTACT_EMAIL=

# ── Platform handles (non-sensitive) ──────────────────────────────────
YOUTUBE_HANDLE=@therevprogamers
PATREON_URL=https://www.patreon.com/cw/VarunSV
BMC_URL=https://buymeacoffee.com/varunsv
BMC_USERNAME=varunsv
GH_USERNAME=Varun-SV
# Comma-separated repo names to show first on /projects/
PINNED_REPOS=

# ── YouTube ───────────────────────────────────────────────────────────
# Channel ID (starts UC...). Find it at youtube.com/account_advanced.
# Without it the build tries to resolve YOUTUBE_HANDLE automatically.
YOUTUBE_CHANNEL_ID=
# Optional. Adds view counts, durations and subscriber count.
# Get one: console.cloud.google.com → enable "YouTube Data API v3" → API key
YOUTUBE_API_KEY=

# ── Patreon (READ ONLY — the API cannot create posts) ─────────────────
# 1. patreon.com/portal/registration/register-clients → create a client
# 2. Copy the "Creator's Access Token" it generates for your own campaign
# Do NOT grant email scopes; this project never reads supporter emails.
PATREON_ACCESS_TOKEN=
PATREON_CAMPAIGN_ID=

# ── Buy Me a Coffee (READ ONLY — the API cannot create posts) ─────────
# buymeacoffee.com/dashboard → Settings ▸ Developers/API → generate token
BMC_ACCESS_TOKEN=

# ── GitHub ────────────────────────────────────────────────────────────
# Optional. Public repo data works unauthenticated at 60 req/hr.
# A token raises that to 5000/hr. Needs NO scopes for public repos.
# NB: a GitHub Actions secret may not start with "GITHUB_" — that prefix is
# reserved — which is why this is GH_API_TOKEN.
GH_API_TOKEN=

# ── Affiliate ─────────────────────────────────────────────────────────
# Appended automatically to bare amazon.* links across every post.
AMAZON_ASSOCIATE_TAG=

# ── Cross-posting: platforms that DO have a write API ─────────────────
# Discord: Server Settings ▸ Integrations ▸ Webhooks ▸ New Webhook
DISCORD_WEBHOOK_URL=
# Telegram: talk to @BotFather for the token; @userinfobot for the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Mastodon: Preferences ▸ Development ▸ New application (scope: write:statuses)
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=
# Dev.to: Settings ▸ Extensions ▸ DEV Community API Keys
DEVTO_API_KEY=

# ── Privacy toggles ───────────────────────────────────────────────────
# Set to false to show supporters as "Anonymous" with no messages.
SHOW_SUPPORTER_NAMES=true
SHOW_SUPPORTER_MESSAGES=true
SUPPORTER_LIMIT=60

# ── Server only (Railway) ─────────────────────────────────────────────
PORT=3000
API_CACHE_SECONDS=600
